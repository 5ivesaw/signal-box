{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signalbox project v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1, "default": 1},
    "source": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0, "default": 1967},
    "width": {"type": "integer", "anyOf": [{"const": 0}, {"minimum": 64, "maximum": 7680}], "default": 854},
    "fps": {"type": "number", "minimum": 0, "maximum": 240, "default": 0},
    "threads": {"type": "integer", "minimum": 1, "maximum": 16, "default": 2},
    "crf": {"type": "integer", "minimum": 0, "maximum": 51, "default": 18},
    "effects": {
      "type": "object",
      "description": "Keys must also exist in the installed catalog. Runtime validates region bounds and time ordering.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {"type": "boolean", "default": true},
          "strength": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
          "locked": {"type": "boolean", "default": false},
          "asset": {"type": "string", "default": ""},
          "start": {"type": "number", "minimum": 0, "default": 0},
          "end": {"type": ["number", "null"], "exclusiveMinimum": 0, "default": null},
          "roi": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}, "default": [0.55, 0.2, 0.25, 0.5]}
        }
      }
    }
  }
}
